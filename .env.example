# URLs das APIs do ecossistema Zelo
# API .NET (cadastro, login, CRUD de lembretes, rede de apoio)
EXPO_PUBLIC_CUIDADO_API_URL=http://localhost:5080/api/v1

# API Java (status da casa, eventos, alertas, check-in conversacional, emergencia)
EXPO_PUBLIC_MONITOR_API_URL=http://localhost:8080/api/v1

# API Python FastAPI (resumos semanais e dias atipicos com IA)
EXPO_PUBLIC_INSIGHTS_API_URL=http://localhost:8000/api/v1

# Fallback inteligente ativo para avaliacao sem backend externo e modo mock
EXPO_PUBLIC_FALLBACK_DEMO=true
EXPO_PUBLIC_USE_MOCK=false
